# Copy this file to .env and fill in the values. Required vars are marked; everything else is optional and
# the app degrades gracefully without it (see the note on each block).

# --- Required ---
PORT=5001
DATABASE_URL=postgresql://user:password@host:5432/cadovet
# Generate with: openssl rand -hex 32   (32+ characters; the API refuses to boot in production without one)
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Set NODE_ENV=production for a real deployment — it turns on the JWT_SECRET strength check below and disables
# the OTP_TEST_CODE / OTP_TEST_MOBILES shortcut further down. Leave unset (or "development") for local work.
NODE_ENV=development
# Your website/admin-portal origin(s), comma separated, no trailing slash — e.g.
# CORS_ORIGIN=https://cadovet.com,https://admin.cadovet.com
# Unset means "no cross-origin browser access" once NODE_ENV=production; "*" works but is logged as a warning.
CORS_ORIGIN=*

# --- Email (any SMTP provider) — optional: without it, password-reset codes are printed to the server console ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# MAIL_FROM="Cado Vet <no-reply@cadovet.com>"

# --- SMS (Twilio) — optional: without it, customer OTP codes are printed to the server console ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=secret
# TWILIO_FROM=+15551234567                      # or use a Messaging Service instead:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_DEFAULT_COUNTRY_CODE=91                   # prepended to 10-digit numbers such as 9876543210

# --- Local development only — do NOT set any of these three in production ---
# Local testing only: echo the reset code in the API response. NEVER enable in production.
# RESET_CODE_IN_RESPONSE=true
# Local testing only: a fixed CUSTOMER sign-in code for the listed numbers, so no SMS provider or server console is needed.
# Staff (admin, doctors, operational head, desk staff) sign in with email + password and are never covered by this.
# Ignored when NODE_ENV=production or when a real SMS provider (Twilio above) is configured. NEVER list real customers.
# OTP_TEST_CODE=123456
# OTP_TEST_MOBILES=9000000021,9000000022,9000000033,9000000001,9000000002,9000000003,9000000004,9000000005
